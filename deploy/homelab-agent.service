[Unit]
Description=Homelab Linux metrics agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root permits smartctl to read health from physical disks. No management commands are exposed.
User=root
EnvironmentFile=/etc/homelab/agent.env
ExecStart=/usr/local/bin/homelab-agent run --config /etc/homelab/agent.yaml
Restart=on-failure
RestartSec=5
StateDirectory=homelab-agent
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target

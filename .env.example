# Generate a token: openssl rand -hex 32. Keep the actual .env private.
HOMELAB_DASHBOARD_TOKEN=
# Use :0.1.0 or @sha256:... to pin an exact release.
HOMELAB_DASHBOARD_IMAGE=ghcr.io/nikitakiselev/homelab-dashboard:stable
# Local access by default. Use your LAN address or 0.0.0.0 for LAN access.
HOMELAB_DASHBOARD_BIND=127.0.0.1
HOMELAB_DASHBOARD_PORT=8080
HOMELAB_DASHBOARD_RETENTION_DAYS=90
